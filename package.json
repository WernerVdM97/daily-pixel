{
  "name": "the-wardens-oak",
  "version": "0.3.5",
  "private": true,
  "description": "The Warden's Oak — Discord MUD POC",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "sim": "tsx src/sim/run.ts",
    "agent:play": "tsx src/agent/play.ts",
    "agent:panel": "tsx src/agent/panel.ts",
    "agent:replay": "tsx src/agent/replay.ts",
    "agent:record-real": "tsx src/agent/deterministicSession.ts",
    "agent:stub": "tsx src/agent/stub.ts",
    "send-dm": "tsx scripts/send-dm.ts",
    "calibrate": "tsx src/sim/calibrate-combat.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
