[Unit]
Description=Fire due Dark Factory agent schedules
Documentation=https://github.com/WernerVdM97/daily-pixel/blob/dev/docs/engine/dark-factory.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=FACTORY_MIN_AVAIL_MB=1000
# A wedged run must not block every later tick for ever. The ceiling bounds the schedule step
# plus the longest job stage: the schedule step was already bounded by the old 1800 and runs
# minutes in practice, the longest stage is 50, so 5400 covers a worst case of 30 + 50 with
# margin rather than headroom to grow into.
TimeoutStartSec=5400
ExecStart=/usr/local/bin/factory-run-due

# User=, HOME=, PATH= (~/.local/bin first, pi lives there) and FACTORY_PROJECT_DIR= are
# per-machine, so they live in a drop-in: `sudo systemctl edit factory-run-due`. Install it
# before the first start, or the unit runs as root. %h cannot stand in for them: under the
# system manager it is /root whatever User= says.
