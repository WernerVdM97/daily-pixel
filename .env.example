# Discord bot token (required)
DISCORD_TOKEN=

# DeepSeek V4 Flash API key (required)
DEEPSEEK_API_KEY=

# Your Discord user ID — enables admin /sleep to advance the world (required)
ADMIN_USER_ID=

# Discord channel ID where the nightly tick announcement is posted (optional for POC)
TICK_CHANNEL_ID=

# When "true", an admin's /sleep advances the whole world (runs the nightly tick)
# instead of only resting their own character. Leave unset/false in normal play.
SLEEP_ADMIN_TICK=false

# Discord channel ID the clear-channel.sh script purges when no id is passed on the
# command line. Used only by scripts/clear-channel.sh (dev/ops), never by the bot.
CLEAR_CHANNEL_ID=

# Log all LLM request/response data to console (debugging) — covers BOTH the legacy
# DeepseekLlmGateway and the v12 pipeline gateway.
VERBOSE_LLM=true
# Log all user interaction traffic (commands, buttons, responses)
VERBOSE=true

# DB deep-capture policy for LLM prompt + reasoning (applies to decision, critic, and pipeline
# stage calls alike). One of:
#   errors  — persist only on diagnostic calls (transport error, parse failure, retry) and
#             critic-flagged decisions. This floor is ALWAYS on, in every mode.
#   spiral  — errors + any call whose reasoning exceeds LLM_SPIRAL_CHARS (default; also the
#             fallback for an unset/invalid value).
#   all     — persist on every call (costs DB space).
# LLM_LOG_THINKING=spiral

# Spiral threshold (reasoning chars) used by LLM_LOG_THINKING=spiral. Default ~6000 (p90).
# LLM_SPIRAL_CHARS=6000

# The coherence critic (decision prompt v9): a second LLM pass that reviews and repairs each
# beat for coherence before it reaches the player. Requires DEEPSEEK_API_KEY. ON by default —
# set this to "false" to opt out (saves the extra LLM pass). Critic calls are audited in
# llm_calls as call_kind='critic'.
# ENABLE_COHERENCE_CRITIC=false

# env var to swap models at boot (logged on init).
# LLM_MODEL=

# Comma-separated regex patterns for content/profanity filtering  
PROFANITY_FILTER=\b(frack|darn|hecka)\b,\botherword\b
