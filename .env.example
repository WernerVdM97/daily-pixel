# Discord bot token (required)
DISCORD_TOKEN=

# DeepSeek V4 Flash API key (required)
DEEPSEEK_API_KEY=

# Your Discord user ID — enables admin /sleep to advance the world (required)
ADMIN_USER_ID=

# Discord channel ID where the nightly tick announcement is posted (optional for POC)
TICK_CHANNEL_ID=

# Set to 'true' to log all LLM request/response data to console (debugging)
VERBOSE_LLM=false

# Set to 'true' to log all user interaction traffic (commands, buttons, responses)
VERBOSE=false
