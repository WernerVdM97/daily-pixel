# agents
.pi-subagents/
# `.pi/` is local agent state, so ignore its contents rather than the directory itself:
# the factory memory skeleton is the one part of it that is tracked.
.pi/*
!.pi/factory/
.pi/factory/*
!.pi/factory/memory/
# Factory memory tree: the topic skeleton (a `.gitkeep` per leaf topic) and its README are
# tracked; agent-written content is not. See .claude/skills/factory-memory/SKILL.md.
.pi/factory/memory/**/*
!.pi/factory/memory/**/
!.pi/factory/memory/**/.gitkeep
!.pi/factory/memory/README.md
.claude/worktrees

# Obsidian — personal config
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/themes/
!.obsidian/themes/**

# Environment
.env

# Dependencies
node_modules/

# Build output
dist/

# Database
*.db
*.db-journal

# Runtime database directory (volume mount for dev)
data/

# Local prod DB backups — keep the helper/analysis scripts, never commit the DB itself.
db-backups/warden-*/
db-backups/.latest
db-backups/*.db
db-backups/*.db-wal
db-backups/*.db-shm

# Sim harness generated output (scenario .json inputs are tracked; results are not)
src/sim/scenarios/*.result.json
src/sim/scenarios/*.csv
# T1 calibration harness output — reproducible via `npm run calibrate`; the curves are
# recorded in docs/engine/T1-combat-calibration.md, so the raw artifact is not tracked.
src/sim/combat-calibration.json

# OS cruft
Thumbs.db
.DS_Store
*:Zone.Identifier
